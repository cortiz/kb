[14.713951, "o", "\u001b[1mTail pod logs\u001b[0m\r\n\u001b[1;38;2;0;175;0mcmd\u001b[0m\u001b[38;2;138;138;138m · #example #k8s · edited 2026-10-12\u001b[0m\r\n\u001b[38;2;138;138;138mcmd/example-tail-pod-logs.md\u001b[0m\r\n\r\n\u001b[38;2;88;88;88m── payload ─────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[38;2;138;138;138m1 \u001b[0m\u001b[38;2;135;175;215mkubectl\u001b[0m\u001b[38;2;188;188;188m --\u001b[0m\u001b[38;2;215;175;95mtoken\u001b[0m \u001b[38;2;135;175;95m\"\u001b[0m\u001b[1;7;38;2;255;175;95m{{token}}\u001b[0m\u001b[38;2;135;175;95m\"\u001b[0m\u001b[38;2;188;188;188m -\u001b[0m\u001b[38;2;215;175;95mn\u001b[0m \u001b[1;7;38;2;255;175;95m{{namespace}}\u001b[0m logs\u001b[38;2;188;188;188m -\u001b[0m\u001b[38;2;215;175;95mf\u001b[0m\u001b[38;2;188;188;188m -\u001b[0m\u001b[38;2;215;175;95ml\u001b[0m app=\u001b[1;7;38;2;255;175;95m{{app}}\u001b[0m\u001b[38;2;188;188;188m --\u001b[0m\u001b[38;2;215;175;95mtail\u001b[0m\u001b[38;2;188;188;188m=\u001b[0m100\r\n\r\n\u001b[38;2;88;88;88m── variables ───────"]
[14.715162, "o", "────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1mnamespace   \u001b[0m\u001b[38;2;138;138;138mtext   \u001b[0m = default\r\n\u001b[1mapp         \u001b[0m\u001b[38;2;138;138;138mtext    — Value of the app label\u001b[0m\r\n\u001b[1mtoken       \u001b[0m\u001b[38;2;138;138;138msecret (prompted)\u001b[0m\r\n\r\n\u001b[38;2;88;88;88m── fields ──────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[38;2;138;138;138mshell      \u001b[0mbash\r\n\r\n\u001b[38;2;88;88;88m── notes ─────────────────────────────────────────────────────────────────"]
[14.715402, "o", "──────────────────────────\u001b[0m\r\nNever paste a real token into an entry. A\u001b[38;2;215;175;135m secret\u001b[0m variable is read from the environment variable\r\nnamed in\u001b[38;2;215;175;135m env\u001b[0m, or prompted for, and is never stored.\r\n"]
