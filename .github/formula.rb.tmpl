class Kb < Formula
  desc "Terminal knowledge base for operational snippets"
  homepage "https://github.com/cortiz/kb"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/cortiz/kb/releases/download/@TAG@/kb-@VERSION@-macos-apple-silicon.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/cortiz/kb/releases/download/@TAG@/kb-@VERSION@-macos-intel.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/cortiz/kb/releases/download/@TAG@/kb-@VERSION@-linux-arm64.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/cortiz/kb/releases/download/@TAG@/kb-@VERSION@-linux-x86_64.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "kb"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/kb --version")
  end
end
